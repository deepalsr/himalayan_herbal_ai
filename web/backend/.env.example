# Himalayan Herbal AI - Web Backend Configuration
# ================================================

# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=himalayan-herbal-ai-dev-key-change-in-production

# API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Session Configuration
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=3600

# CORS Configuration
CORS_ORIGINS=*
